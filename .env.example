# PostgreSQL (Neon integration in Vercel Marketplace)
DATABASE_URL=
# Generate two different random values of at least 32 characters.
BETTER_AUTH_SECRET=
DASHHAN_SETUP_CODE=
# Only this email can create an account or open the workspace.
DASHHAN_OWNER_EMAIL=
# Production domain, e.g. https://das-han.vercel.app. Leave unset for previews.
BETTER_AUTH_URL=
# Connect a PRIVATE Vercel Blob store. Vercel may inject either store ID/OIDC or token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
